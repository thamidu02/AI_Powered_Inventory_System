FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Copy project file and restore dependencies first (layer caching)
COPY ["RestaurantInventory.API.csproj", "."]
RUN dotnet restore

# Copy the rest and publish
COPY . .
RUN dotnet publish -c Release --no-restore -o /app/publish /p:UseAppHost=false

# ---- Runtime image ----
FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app

COPY --from=build /app/publish .

ENV DOTNET_EnableDiagnostics=0

# The base aspnet image sets ASPNETCORE_HTTP_PORTS=8080 by default.
# Vercel injects PORT at runtime — we must override ASPNETCORE_HTTP_PORTS
# so the app binds to the port Vercel expects.
CMD ["sh", "-c", "ASPNETCORE_HTTP_PORTS=${PORT:-8080} dotnet RestaurantInventory.API.dll"]
