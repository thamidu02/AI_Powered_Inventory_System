# ─────────────────────────────────────────────────────────────────────────────
# AI Service — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Gemini API ────────────────────────────────────────────────────────────────
# Get your key from https://aistudio.google.com/app/apikey
# Supported Gemini model used by the agent.
GEMINI_MODEL=gemini-3.5-flash-lite
# Paid tier: no daily cap — enable billing at https://ai.dev
GCP_API_KEY=your-gcp-api-key-here

# ── .NET Backend ──────────────────────────────────────────────────────────────
# Base URL of the running RestaurantInventory.API (dotnet run).
# Default port is 5066 — change if overridden in launchSettings.json.
BACKEND_BASE_URL=http://localhost:5066

# ── Service Account (AI agent authentication) ─────────────────────────────────
# The AI service logs in with these credentials to get a JWT from the backend.
# The account must have the INVENTORY_MANAGER role.
SERVICE_ACCOUNT_EMAIL=inventory@restaurant.com
SERVICE_ACCOUNT_PASSWORD=Restaurant@123
